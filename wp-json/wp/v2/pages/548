           class=\"tea-lawyer-mobile\"\r\n                src=\"https:\/\/teste.medicalshopping.com.br\/wp-content\/uploads\/2026\/09\/ChatGPT-Image-3-de-set.-de-2026-11_11_16.png\"\r\n                alt=\"\"\r\n                aria-hidden=\"true\"\r\n            >\r\n\r\n\r\n        <\/div>\r\n\r\n    <\/div>\r\n\r\n<\/section>\r\n\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function () {\r\n\r\n    const slider = document.querySelector(\".tea-cards\");\r\n\r\n    if (!slider) {\r\n        return;\r\n    }\r\n\r\n\r\n    const mobileMedia = window.matchMedia(\"(max-width: 700px)\");\r\n    const reduceMotion = window.matchMedia(\r\n        \"(prefers-reduced-motion: reduce)\"\r\n    );\r\n\r\n\r\n    let paused = false;\r\n    let animationFrame = null;\r\n    let lastTime = null;\r\n    let cloned = false;\r\n\r\n    \/*\r\n     * Velocidade em pixels por segundo.\r\n     * Para acelerar, aumente.\r\n     * Para diminuir, reduza.\r\n     *\/\r\n    const SCROLL_SPEED = 24;\r\n\r\n\r\n    \/* =====================================================\r\n       DUPLICA OS CARDS PARA O LOOP FICAR CONT\u00cdNUO\r\n    ===================================================== *\/\r\n\r\n    function createLoop() {\r\n\r\n        if (cloned) {\r\n            return;\r\n        }\r\n\r\n\r\n        const cards = Array.from(\r\n            slider.querySelectorAll(\".tea-card\")\r\n        );\r\n\r\n\r\n        cards.forEach(function (card) {\r\n\r\n            const clone = card.cloneNode(true);\r\n\r\n            clone.classList.add(\"tea-card-clone\");\r\n\r\n            clone.setAttribute(\"aria-hidden\", \"true\");\r\n\r\n            slider.appendChild(clone);\r\n\r\n        });\r\n\r\n\r\n        cloned = true;\r\n\r\n    }\r\n\r\n\r\n    \/* =====================================================\r\n       REMOVE OS CLONES\r\n    ===================================================== *\/\r\n\r\n    function removeLoop() {\r\n\r\n        slider\r\n            .querySelectorAll(\".tea-card-clone\")\r\n            .forEach(function (clone) {\r\n\r\n                clone.remove();\r\n\r\n            });\r\n\r\n\r\n        cloned = false;\r\n\r\n        slider.scrollLeft = 0;\r\n\r\n    }\r\n\r\n\r\n    \/* =====================================================\r\n       LOOP DE MOVIMENTO\r\n    ===================================================== *\/\r\n\r\n    function animate(time) {\r\n\r\n        if (!mobileMedia.matches) {\r\n\r\n            animationFrame = null;\r\n\r\n            return;\r\n        }\r\n\r\n\r\n        if (lastTime === null) {\r\n\r\n            lastTime = time;\r\n\r\n        }\r\n\r\n\r\n        const delta = time - lastTime;\r\n\r\n        lastTime = time;\r\n\r\n\r\n        if (\r\n            !paused &&\r\n            !reduceMotion.matches &&\r\n            slider.scrollWidth > slider.clientWidth\r\n        ) {\r\n\r\n            slider.scrollLeft +=\r\n                (SCROLL_SPEED * delta) \/ 1000;\r\n\r\n\r\n            const half =\r\n                slider.scrollWidth \/ 2;\r\n\r\n\r\n            if (slider.scrollLeft >= half) {\r\n\r\n                slider.scrollLeft -= half;\r\n\r\n            }\r\n\r\n        }\r\n\r\n\r\n        animationFrame =\r\n            requestAnimationFrame(animate);\r\n\r\n    }\r\n\r\n\r\n    \/* =====================================================\r\n       INICIA\r\n    ===================================================== *\/\r\n\r\n    function start() {\r\n\r\n        if (!mobileMedia.matches) {\r\n            return;\r\n        }\r\n\r\n\r\n        createLoop();\r\n\r\n\r\n        if (animationFrame === null) {\r\n\r\n            lastTime = null;\r\n\r\n            animationFrame =\r\n                requestAnimationFrame(animate);\r\n\r\n        }\r\n\r\n    }\r\n\r\n\r\n    \/* =====================================================\r\n       PARA\r\n    ===================================================== *\/\r\n\r\n    function stop() {\r\n\r\n        if (animationFrame !== null) {\r\n\r\n            cancelAnimationFrame(animationFrame);\r\n\r\n            animationFrame = null;\r\n\r\n        }\r\n\r\n\r\n        lastTime = null;\r\n    }\r\n\r\n\r\n    \/* =====================================================\r\n       HOVER DO MOUSE\r\n    ===================================================== *\/\r\n\r\n    slider.addEventListener(\r\n        \"mouseenter\",\r\n        function () {\r\n\r\n            paused = true;\r\n\r\n        }\r\n    );\r\n\r\n\r\n    slider.addEventListener(\r\n        \"mouseleave\",\r\n        function () {\r\n\r\n            paused = false;\r\n\r\n        }\r\n    );\r\n\r\n\r\n    \/* =====================================================\r\n       TOQUE\r\n    ===================================================== *\/\r\n\r\n    slider.addEventListener(\r\n        \"touchstart\",\r\n        function () {\r\n\r\n            paused = true;\r\n\r\n        },\r\n        {\r\n            passive: true\r\n        }\r\n    );\r\n\r\n\r\n    slider.addEventListener(\r\n        \"touchend\",\r\n        function () {\r\n\r\n            window.setTimeout(\r\n                function () {\r\n\r\n                    paused = false;\r\n\r\n                },\r\n                1200\r\n            );\r\n\r\n        },\r\n        {\r\n            passive: true\r\n        }\r\n    );\r\n\r\n\r\n    \/* =====================================================\r\n       MOUSE PRESSIONADO\r\n    ===================================================== *\/\r\n\r\n    slider.addEventListener(\r\n        \"mousedown\",\r\n        function () {\r\n\r\n            paused = true;\r\n\r\n        }\r\n    );\r\n\r\n\r\n    window.addEventListener(\r\n        \"mouseup\",\r\n        function () {\r\n\r\n            window.setTimeout(\r\n                function () {\r\n\r\n                    paused = false;\r\n\r\n                },\r\n                500\r\n            );\r\n\r\n        }\r\n    );\r\n\r\n\r\n    \/* =====================================================\r\n       AO TROCAR DE MOBILE PARA TABLET\/DESKTOP\r\n    ===================================================== *\/\r\n\r\n    function handleViewportChange() {\r\n\r\n        if (mobileMedia.matches) {\r\n\r\n            start();\r\n\r\n        } else {\r\n\r\n            paused = false;\r\n\r\n            stop();\r\n\r\n            removeLoop();\r\n\r\n        }\r\n\r\n    }\r\n\r\n\r\n    mobileMedia.addEventListener(\r\n        \"change\",\r\n        handleViewportChange\r\n    );\r\n\r\n\r\n    \/* =====================================================\r\n       INICIALIZA\u00c7\u00c3O\r\n    ===================================================== *\/\r\n\r\n    handleViewportChange();\r\n\r\n});\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-b9f7ac9 e-con-full e-flex e-con e-child\" data-id=\"b9f7ac9\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-65acd3f elementor-widget elementor-widget-html\" data-id=\"65acd3f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\r\n\/* =========================================================\r\n   BLOCO DE COMPROMISSO \u2014 TEA\r\n========================================================= *\/\r\n\r\n.tea-commitment-section {\r\n    width: 100%;\r\n    padding: 15px 0;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n}\r\n\r\n.tea-commitment-container {\r\n    width: min(1200px, calc(100% - 40px));\r\n    margin: 0 auto;\r\n}\r\n\r\n\r\n\/* BLOCO *\/\r\n\r\n.tea-commitment {\r\n    min-height: 105px;\r\n\r\n    padding: 18px 55px;\r\n\r\n    display: grid;\r\n    grid-template-columns: 120px 1px 1fr 1px 300px;\r\n    align-items: center;\r\n    gap: 28px;\r\n\r\n    background: #f3e7dc;\r\n\r\n    border-radius: 11p