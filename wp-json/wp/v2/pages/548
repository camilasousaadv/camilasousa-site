FFFF;\r\n    font-family:'Inter',sans-serif;\r\n  }\r\n\r\n  .servicos{\r\n    position:relative;\r\n    background:v#FFFFFF;\r\n    padding: 34px 0;\r\n  }\r\n\r\n  \/* ---------- carrossel ---------- *\/\r\n  .carrossel{\r\n    position:relative;\r\n    max-width:1240px;\r\n    margin:0 auto;\r\n    padding:0 64px;\r\n  }\r\n  .carrossel__viewport{\r\n    overflow:hidden;\r\n  }\r\n  .carrossel__track{\r\n    display:flex;\r\n    gap:28px;\r\n    transition:transform 0.55s cubic-bezier(0.65,0,0.35,1);\r\n    will-change:transform;\r\n  }\r\n\r\n  .card{\r\n    flex:0 0 calc((100% - 56px) \/ 3);\r\n    background:linear-gradient(165deg, #9c3018 0%, var(--brick) 38%, var(--wine) 100%);\r\n    border-radius:14px;\r\n    padding:24px 20px 20px;\r\n    position:relative;\r\n    z-index:2;\r\n  }\r\n  .card__icon{\r\n    width:34px;\r\n    height:34px;\r\n    margin-bottom:16px;\r\n    color:var(--text-strong);\r\n  }\r\n  .card__icon svg{\r\n    width:100%;\r\n    height:100%;\r\n    stroke:var(--text-strong);\r\n    fill:none;\r\n    stroke-width:1.4;\r\n  }\r\n  .card__title{\r\n    font-family:'Cormorant Garamond',serif;\r\n    font-weight:700;\r\n    font-size:22px;\r\n    line-height:1.28;\r\n    color:var(--text-strong);\r\n    margin:0 0 5px;\r\n  }\r\n  .card__desc{\r\n    font-family:'Inter',sans-serif;\r\n    font-size:14.5px;\r\n    line-height:1.68;\r\n    color:var(--text-soft);\r\n    margin:0;\r\n  }\r\n\r\n  \/* ---------- setas ---------- *\/\r\n  .carrossel__arrow{\r\n    position:absolute;\r\n    top:50%;\r\n    transform:translateY(-50%);\r\n    width:44px;\r\n    height:44px;\r\n    border-radius:50%;\r\n    border:1px solid rgba(133,33,13,0.35);\r\n    background:#fff;\r\n    color:var(--brick);\r\n    display:flex;\r\n    align-items:center;\r\n    justify-content:center;\r\n    cursor:pointer;\r\n    z-index:5;\r\n    transition:background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;\r\n  }\r\n  .carrossel__arrow:hover{\r\n    background:var(--brick);\r\n    border-color:var(--brick);\r\n  }\r\n  .carrossel__arrow:hover svg{ stroke:#fff; }\r\n  .carrossel__arrow[disabled]{\r\n    opacity:0.28;\r\n    cursor:default;\r\n    pointer-events:none;\r\n  }\r\n  .carrossel__arrow svg{\r\n    width:18px;\r\n    height:18px;\r\n    stroke:currentColor;\r\n    fill:none;\r\n    stroke-width:1.8;\r\n  }\r\n  .carrossel__arrow--prev{ left:8px; }\r\n  .carrossel__arrow--next{ right:8px; }\r\n\r\n  \/* ---------- responsivo ---------- *\/\r\n  @media (max-width:980px){\r\n    .card{ flex:0 0 calc((100% - 28px) \/ 2); }\r\n  }\r\n  @media (max-width:640px){\r\n    .carrossel{ padding:0 44px; }\r\n    .card{ flex:0 0 100%; }\r\n    .carrossel__arrow{ width:38px; height:38px; }\r\n  }\r\n<\/style>\r\n<\/head>\r\n<body>\r\n\r\n<section class=\"servicos\">\r\n\r\n    <div class=\"carrossel\">\r\n\r\n      <button class=\"carrossel__arrow carrossel__arrow--prev\" id=\"prevBtn\" aria-label=\"Servi\u00e7o anterior\">\r\n        <svg viewBox=\"0 0 24 24\"><path d=\"M15 5l-7 7 7 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n      <\/button>\r\n\r\n      <div class=\"carrossel__viewport\">\r\n        <div class=\"carrossel__track\" id=\"track\">\r\n\r\n          <article class=\"card\">\r\n            <div class=\"card__icon\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M4 20V17.5C4 15 8 13.8 12 13.8C16 13.8 20 15 20 17.5V20\" stroke-linecap=\"round\"\/><rect x=\"7\" y=\"4\" width=\"10\" height=\"6\" rx=\"2\"\/><\/svg>\r\n            <\/div>\r\n            <h3 class=\"card__title\">Direito do Trabalho<\/h3>\r\n            <p class=\"card__desc\">Atua\u00e7\u00e3o especializada em quest\u00f5es relacionadas \u00e0s rela\u00e7\u00f5es de trabalho, oferecendo orienta\u00e7\u00e3o e representa\u00e7\u00e3o jur\u00eddica.<\/p>\r\n          <\/article>\r\n\r\n          <article class=\"card\">\r\n            <div class=\"card__icon\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 3l7 3v5c0 4.6-3 8.6-7 10-4-1.4-7-5.4-7-10V6l7-3z\" stroke-linejoin=\"round\"\/><path d=\"M9 12l2 2 4-4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/div>\r\n            <h3 class=\"card__title\">Direito Previdenci\u00e1rio (INSS)<\/h3>\r\n            <p class=\"card__desc\">Assessoria em demandas relacionadas ao INSS, benef\u00edcios previdenci\u00e1rios, aposentadorias e demais quest\u00f5es previdenci\u00e1rias.<\/p>\r\n          <\/article>\r\n\r\n          <article class=\"card\">\r\n            <div class=\"card__icon\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M6 8h12l-1 12H7L6 8z\" stroke-linejoin=\"round\"\/><path d=\"M9 8V6a3 3 0 016 0v2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/div>\r\n            <h3 class=\"card__title\">Direito do Consumidor<\/h3>\r\n            <p class=\"card__desc\">Atua\u00e7\u00e3o na defesa dos direitos do consumidor em conflitos e situa\u00e7\u00f5es relacionadas \u00e0s rela\u00e7\u00f5es de consumo.<\/p>\r\n          <\/article>\r\n\r\n          <article class=\"card\">\r\n            <div class=\"card__icon\">\r\n              <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"\/><path d=\"M3 7l9 6 9-6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/div>\r\n            <h3 class=\"card__title\">Correspond\u00eancia Jur\u00eddica<\/h3>\r\n            <p class=\"card__desc\">Presta\u00e7\u00e3o de servi\u00e7os de correspond\u00eancia jur\u00eddica para advogados e escrit\u00f3rios, com atua\u00e7\u00e3o em Bel\u00e9m\/PA e regi\u00e3o.<\/p>\r\n          <\/article>\r\n\r\n          <article class=\"card\">\r\n            <div class=\"card__icon\">\r\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"\/><path d=\"M14.5 9.5L13 13l-3.5 1.5L11 11l3.5-1.5z\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/div>\r\n            <h3 class=\"card__title\">Assessoria Jur\u00eddica<\/h3>\r\n            <p class=\"card__desc\">Orienta\u00e7\u00e3o jur\u00eddica personalizada e estrat\u00e9gica para preven\u00e7\u00e3o e resolu\u00e7\u00e3o de quest\u00f5es legais.<\/p>\r\n          <\/article>\r\n\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <button class=\"carrossel__arrow carrossel__arrow--next\" id=\"nextBtn\" aria-label=\"Pr\u00f3ximo servi\u00e7o\">\r\n        <svg viewBox=\"0 0 24 24\"><path d=\"M9 5l7 7-7 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n      <\/button>\r\n\r\n    <\/div>\r\n\r\n<\/section>\r\n\r\n<script>\r\n  const track = document.getElementById('track');\r\n  const prevBtn = document.getElementById('prevBtn');\r\n  const nextBtn = document.getElementById('nextBtn');\r\n  const totalCards = track.children.length;\r\n\r\n  function getVisible(){\r\n    const w = window.innerWidth;\r\n    if(w <= 640) return 1;\r\n    if(w <= 980) return 2;\r\n    return 3;\r\n  }\r\n\r\n  let index = 0;\r\n\r\n  function update(){\r\n    const visible = getVisible();\r\n    const maxIndex = Math.max(0, totalCards - visible);\r\n    index = Math.min(index, maxIndex);\r\n\r\n    const card = track.children[0];\r\n    const cardWidth = card.getBoundingClientRect().width;\r\n    const gap = parseFloat(getComputedStyle(track).gap) || 0;\r\n    const offset = index * (cardWidth + gap);\r\n\r\n    track.style.transform = `translateX(-${offset}px)`;\r\n\r\n    prevBtn.disabled = index === 0;\r\n    nextBtn.disabled = index >= maxIndex;\r\n  }\r\n\r\n  prevBtn.addEventListener('click', () => { index = Math.max(0, index - 1); update(); });\r\n  nextBtn.addEventListener('click', () => {\r\n    const visible = getVisible();\r\n    const maxIndex = Math.max(0, totalCards - visible);\r\n    index = Math.min(maxIndex, index + 1);\r\n    update();\r\n  });\r\n\r\n  window.addEventListener('resize', update);\r\n  window.addEventListener('load', update);\r\n  update();\r\n<\/script>\r\n\r\n<\/body>\r\n<\/html>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-c665f63 e-flex e-con-boxed e-con e-parent\" data-id=\"c665f63\" data-element_type=\"container\" data-e-type=\"container\" id=\"tea\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-d4b09b0 e-con-full e-flex e-con e-child\" data-id=\"d4b09b0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-767b963 elementor-widget elementor-widget-html\" data-id=\"767b963\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;_animation_mobile&quot;:&quot;fadeInUp&quot;}\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\r\n\/* =========================================================\r\n   DIREITOS DAS PESSOAS COM TEA\r\n   RESPONSIVO: DESKTOP \/ TABLET \/ MOBILE\r\n========================================================= *\/\r\n\r\n.tea-hero {\r\n    --tea-gold: #d3a34d;\r\n    --tea-gold-light: #e7c16d;\r\n    --tea-red: #7c160d;\r\n    --tea-dark: #350603;\r\n    --tea-cream: #f4e8dc;\r\n\r\n    position: relative;\r\n    width: 100%;\r\n    overflow: hidden;\r\n\r\n    background-color: #3b0603;\r\n\r\n    font-family: Arial, Helvetica, sans-serif;\r\n}\r\n\r\n.tea-hero *,\r\n.tea-hero *::before,\r\n.tea-hero *::after {\r\n    box-sizing: border-box;\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   ELEMENTOS COMUNS\r\n========================================================= *\/\r\n\r\n.tea-hero-container {\r\n    position: relative;\r\n    z-index: 2;\r\n    margin: 0 auto;\r\n}\r\n\r\n.tea-content {\r\n    position: relative;\r\n    z-index: 3;\r\n}\r\n\r\n.tea-eyebrow {\r\n    display: inline-flex;\r\n    align-items: center;\r\n\r\n    width: fit-content;\r\n\r\n    color: var(--tea-gold-light);\r\n\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.tea-eyebrow::before {\r\n    content: \"\";\r\n\r\n    display: block;\r\n\r\n    background: var(--tea-gold);\r\n}\r\n\r\n.tea-title {\r\n    margin-top: 0;\r\n\r\n    color: #fff;\r\n\r\n    font-family: Georgia, \"Times New Roman\", serif;\r\n    font-weight: 400;\r\n}\r\n\r\n.tea-title span {\r\n    display: block;\r\n    color: var(--tea-gold-light);\r\n}\r\n\r\n.tea-description {\r\n    color: rgba(255, 255, 255, 0.94);\r\n}\r\n\r\n.tea-description strong {\r\n    color: #fff;\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   CARDS \u2014 BASE\r\n========================================================= *\/\r\n\r\n.tea-card {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n    text-align: center;\r\n\r\n    background:\r\n        linear-gradient(\r\n            145deg,\r\n            rgba(117, 27, 16, 0.94),\r\n            rgba(49, 5, 2, 0.96)\r\n        );\r\n\r\n    border: 1px solid rgba(211, 163, 77, 0.78);\r\n    border-radius: 8px;\r\n\r\n    backdrop-filter: blur(3px);\r\n    -webkit-backdrop-filter: blur(3px);\r\n\r\n    transition:\r\n        transform 0.25s ease,\r\n        border-color 0.25s ease,\r\n        background 0.25s ease;\r\n}\r\n\r\n.tea-card:hover {\r\n    transform: translateY(-4px);\r\n\r\n    border-color: var(--tea-gold-light);\r\n\r\n    background:\r\n        linear-gradient(\r\n            145deg,\r\n            rgba(139, 38, 22, 0.97),\r\n            rgba(65, 7, 3, 0.98)\r\n        );\r\n}\r\n\r\n.tea-icon {\r\n    color: var(--tea-gold-light);\r\n}\r\n\r\n.tea-icon svg {\r\n    display: block;\r\n    width: 100%;\r\n    height: 100%;\r\n}\r\n\r\n.tea-card h3 {\r\n    margin-top: 0;\r\n\r\n    color: #fff;\r\n\r\n    font-family: Georgia, \"Times New Roman\", serif;\r\n    font-weight: 400;\r\n}\r\n\r\n.tea-card p {\r\n    margin: 0;\r\n\r\n    color: rgba(255, 255, 255, 0